{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // shadcn/ui primitives (`apps/web/components.json`): each file is the full component copied
  // from `npx shadcn add`, not authored per call site. It intentionally exports its whole Radix
  // API — variants, sub-parts like `DialogPortal` / `DropdownMenuSub*` — so a future call site
  // can reach for any of it without re-running the generator. Pruning to "only what's imported
  // today" fights the next `shadcn add` and the component's own docs, so these stay ignored
  // rather than trimmed.
  "ignore": ["apps/web/components/ui/**"],

  "workspaces": {
    ".": {
      // Manual CLI tools invoked as `node scripts/<name>.mjs` (see docs/development.md,
      // docs/testing.md, apps/api/Dockerfile) — never through a package.json script, so knip's
      // default entry detection misses them.
      "entry": ["scripts/*.mjs"]
    },
    "apps/api": {
      // `generate-openapi.ts` is run compiled, as `node dist/openapi/generate-openapi.js`
      // (apps/api/package.json's `openapi` / `openapi:check` scripts) — knip needs the source
      // entry to trace it.
      "entry": ["src/main.ts", "src/openapi/generate-openapi.ts"],
      // `@prisma/client-runtime-utils`: knip only sees TypeScript import specifiers, and every
      // reference to this package is a bare `require("@prisma/client-runtime-utils")` inside
      // Prisma's *generated* client output (`src/generated/prisma/runtime/client.js`, plain
      // JS, gitignored, regenerated by `prisma generate`) — invisible to knip's source scan.
      // It looks redundant because `@prisma/client` also depends on it, but that transitive
      // copy lives inside `@prisma/client`'s own pnpm-isolated `node_modules`, not apps/api's:
      // the generated client file sits under `apps/api/src`, so Node's module resolution walks
      // up *apps/api's own* `node_modules` looking for it. Removing this direct dependency
      // (tried during the knip sweep that added this file) built and unit-tested clean —
      // Jest mocks `PrismaService` rather than loading the real generated runtime — but the
      // compiled server crashed on boot with `Cannot find module '@prisma/client-runtime-utils'`
      // the moment a real request touched Prisma. Keep it direct.
      "ignoreDependencies": ["@prisma/client-runtime-utils"]
    },
    "e2e": {
      // The performance measurement rig: deliberately not part of the smoke suite, run by hand
      // via `playwright test -c measure.config.ts` (see measure.config.ts's own header).
      "entry": ["measure.config.ts", "measure/*.measure.ts"]
    }
  }
}
