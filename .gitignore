# Dependencies
node_modules/
.pnpm-store/

# Environment
.env
.env.local
.env.*.local
# Object-storage credentials for the backup sidecar's off-host copy, read by the `backup`
# service only (docs/self-hosting.md#off-host-copies). Same reason as .env: it holds secrets.
rclone.env
rclone.conf

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma generated client (Prisma 7 output)
apps/api/src/generated/

# Test / coverage
coverage/
.nyc_output/
# Playwright output: HTML report, traces, screenshots, and the CI blob report. All
# regenerated by every browser-suite run.
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# Logs and caches
*.log
npm-debug.log*
pnpm-debug.log*
.eslintcache
.turbo/
.cache/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# AI assistant config — local to each machine, never shared
.claude/
.cursor/
.cursorrules
# Written, and re-added, by every `next dev` run
# (node_modules/next/dist/server/lib/generate-agent-files.js). They describe the installed Next
# version, not this repo, so they are a dev-server artifact rather than a committed rule file;
# the repo's own agent rules live in the tracked root CLAUDE.md. Listed by full path so that
# root CLAUDE.md is not caught with them.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Docker volumes / local overrides
docker-compose.override.yml

# Audit artifacts (local only — reports, findings, roadmap data)
# Anchored to the repo root: unanchored it matched a directory named `audit` at any depth,
# which silently swallowed e2e/audit/, the checked-in accessibility rig.
/audit/
